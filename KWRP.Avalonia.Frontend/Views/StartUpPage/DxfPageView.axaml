<UserControl
    x:Class="KWRP.Avalonia.Frontend.Views.StartUpPage.DxfPageView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:logmodel="using:KWRP.Avalonia.Backend.Model"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:KWRP.Avalonia.Frontend.ViewModels.StartUpPage"
    d:DesignHeight="650"
    d:DesignWidth="1000"
    x:CompileBindings="True"
    x:DataType="vm:DxfPageViewModel"
    mc:Ignorable="d">

    <UserControl.Styles>

        <Style Selector="TextBlock.title">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="20" />
        </Style>

        <Style Selector="TextBlock.header">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBlock.description">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="Gray" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="NumericUpDown.content">
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="MaxWidth" Value="400" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="10,2,0,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FormatString" Value="0" />
            <Setter Property="Increment" Value="1" />
            <Setter Property="ShowButtonSpinner" Value="{Binding !$self.IsReadOnly}" />
            <Setter Property="Background" Value="{Binding $self.IsReadOnly, Converter={StaticResource ReadOnlyToTransparentConverter}}" />
        </Style>

        <Style Selector="TextBox.content">
            <Setter Property="MinWidth" Value="250" />
            <Setter Property="MaxWidth" Value="500" />
            <Setter Property="Margin" Value="10,2,0,2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{Binding $self.IsReadOnly, Converter={StaticResource ReadOnlyToTransparentConverter}}" />
        </Style>


    </UserControl.Styles>

    <ScrollViewer>

        <Grid RowDefinitions="auto, *">
            <StackPanel Margin="10,20" Spacing="16">

                <TextBlock
                    Margin="0,0,0,10"
                    HorizontalAlignment="Center"
                    FontSize="24"
                    FontWeight="Bold"
                    Text="背景図設定" />

                <Grid
                    Grid.Column="0"
                    HorizontalAlignment="Center"
                    RowDefinitions="auto auto auto *">
                    <Grid
                        Grid.Row="0"
                        Margin="0,10"
                        ColumnDefinitions="auto *">
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Command="{Binding AddOptionCommand}" Content="＋新規作成" />
                            <Button
                                Margin="10,0,0,0"
                                Command="{Binding RemoveOptionCommand}"
                                Content="🗑削除"
                                IsEnabled="{Binding SelectedOption.Value, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <ComboBox
                                MinWidth="150"
                                HorizontalAlignment="Right"
                                ItemsSource="{Binding Options}"
                                SelectedItem="{Binding SelectedOption.Value, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="vm:DxfConverterOptionViewModel">
                                        <TextBlock Text="{Binding Title}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                        </StackPanel>
                    </Grid>

                    <Border
                        Name="dxfform"
                        Grid.Row="1"
                        Background="#e1e1e1"
                        CornerRadius="5"
                        IsVisible="{Binding SelectedOption.Value, Converter={x:Static ObjectConverters.IsNotNull}}">

                        <Grid
                            Margin="10"
                            ColumnDefinitions="auto *"
                            RowDefinitions="auto auto auto auto auto auto auto auto *">


                            <StackPanel
                                Grid.Row="0"
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock Classes="header" Text="タイトル" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1">
                                <TextBox Classes="content" Text="{Binding SelectedOption.Value.Title, FallbackValue=setting}" />
                                <TextBlock
                                    Margin="10,0,0,5"
                                    FontSize="10"
                                    Foreground="Red"
                                    IsVisible="{Binding !SelectedOption.Value.IsTitleValid}">
                                    ファイル名に使用できない文字が含まれています。
                                </TextBlock>
                            </StackPanel>


                            <StackPanel
                                Grid.Row="1"
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock Classes="header" Text="背景図ファイル名" />
                            </StackPanel>
                            <TextBox
                                Grid.Row="1"
                                Grid.Column="1"
                                Classes="content"
                                Text="{Binding SelectedOption.Value.DxfFilePath}"
                                Watermark="右のボタンからDXFファイルを選択">
                                <TextBox.InnerRightContent>
                                    <Button
                                        Padding="15,5"
                                        Command="{Binding SetDxfPathCommand}"
                                        Content="...">
                                        <Button.Styles>
                                            <FluentTheme />
                                        </Button.Styles>
                                    </Button>
                                </TextBox.InnerRightContent>
                            </TextBox>




                            <StackPanel
                                Grid.Row="2"
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock Classes="header" Text="現場中心座標" />
                            </StackPanel>
                            <WrapPanel Grid.Row="2" Grid.Column="1">
                                <StackPanel
                                    Margin="10,3"
                                    Orientation="Horizontal"
                                    Spacing="5">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Classes="header"
                                        Text="X" />
                                    <NumericUpDown Classes="content" Value="{Binding SelectedOption.Value.CenterX, FallbackValue=3.0}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Classes="header"
                                        Text="(m)" />
                                </StackPanel>
                                <StackPanel
                                    Margin="10,3"
                                    Orientation="Horizontal"
                                    Spacing="5">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Classes="header"
                                        Text="Y" />
                                    <NumericUpDown Classes="content" Value="{Binding SelectedOption.Value.CenterY, FallbackValue=3.0}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Classes="header"
                                        Text="(m)" />
                                </StackPanel>

                            </WrapPanel>


                            <StackPanel
                                Grid.Row="3"
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock Classes="header" Text="切り取り範囲" />
                            </StackPanel>

                            <WrapPanel Grid.Row="3" Grid.Column="1">
                                <StackPanel
                                    Margin="10,3"
                                    Orientation="Horizontal"
                                    Spacing="5">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Classes="header"
                                        Text="縦" />
                                    <NumericUpDown
                                        Classes="content"
                                        Minimum="1"
                                        Value="{Binding SelectedOption.Value.MapHeight, FallbackValue=3.0}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Classes="header"
                                        Text="(m)" />
                                </StackPanel>
                                <StackPanel
                                    Margin="10,3"
                                    Orientation="Horizontal"
                                    Spacing="5">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Classes="header"
                                        Text="横" />
                                    <NumericUpDown
                                        Classes="content"
                                        Minimum="1"
                                        Value="{Binding SelectedOption.Value.MapWidth, FallbackValue=3.0}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Classes="header"
                                        Text="(m)" />
                                </StackPanel>

                            </WrapPanel>



                            <StackPanel
                                Grid.Row="4"
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock Classes="header" Text="1.0m あたりのピクセル数" />
                            </StackPanel>
                            <NumericUpDown
                                Grid.Row="4"
                                Grid.Column="1"
                                Classes="content"
                                FormatString="0"
                                Increment="1"
                                Maximum="15"
                                Minimum="1"
                                Value="{Binding SelectedOption.Value.PixelsPerMeter, FallbackValue=5}" />


                            <Button
                                Grid.Row="5"
                                Grid.ColumnSpan="2"
                                Margin="10,10,10,5"
                                Padding="20,8"
                                IsEnabled="{Binding SelectedOption.Value.IsTitleValid}"
                                HorizontalAlignment="Center"
                                Command="{Binding RunConversionCommand}">
                                <Button.Content>
                                    <TextBlock>
                                        <Run Text="背景図作成" />
                                        <Run Text="{Binding SelectedOption.Value.PngSize}" />
                                    </TextBlock>
                                </Button.Content>
                            </Button>

                        </Grid>

                    </Border>

                </Grid>

            </StackPanel>

            <Border
                Grid.Row="1"
                Width="{Binding #dxfform.Bounds.Width}"
                MaxWidth="400"
                Margin="0,0,0,15"
                Background="White"
                BorderBrush="LightGray"
                BorderThickness="1"
                IsVisible="{Binding Thumnail.Value, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Image Source="{Binding Thumnail.Value}" Stretch="Uniform">
                    <Image.RenderTransform>
                        <ScaleTransform ScaleY="-1" />
                    </Image.RenderTransform>
                </Image>
            </Border>
        </Grid>

    </ScrollViewer>


</UserControl>
