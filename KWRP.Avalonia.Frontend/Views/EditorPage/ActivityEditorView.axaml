<UserControl
    x:Class="KWRP.Avalonia.Frontend.Views.EditorPage.ActivityEditorView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:KWRP.Avalonia.Frontend.ViewModels.EditorPage"
    MaxWidth="400"
    x:CompileBindings="True"
    x:DataType="vm:ActivityEditorViewModel"
    Background="White"
    Focusable="True"
    mc:Ignorable="d">

	<UserControl.Styles>
        <Style Selector="TextBlock.title">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="20" />
        </Style>
		
        <Style Selector="TextBlock.header">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="NumericUpDown.content">
            <Setter Property="MinWidth" Value="130" />
            <Setter Property="Margin" Value="10,-5,0,-3" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FormatString" Value="0.00" />
            <Setter Property="Increment" Value="0.1" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="ShowButtonSpinner" Value="{Binding !$self.IsReadOnly}" />
            <Setter Property="Background" Value="{Binding $self.IsReadOnly, Converter={StaticResource ReadOnlyToTransparentConverter}}" />
            <Setter Property="RenderTransform" Value="Scale(0.9)" />
            <Setter Property="RenderTransformOrigin" Value="100%,50%" />
        </Style>

        <Style Selector="NumericUpDown.int">
            <Setter Property="MinWidth" Value="130" />
            <Setter Property="Margin" Value="10,-5,0,-3" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FormatString" Value="0" />
            <Setter Property="Increment" Value="1" />
            <Setter Property="Minimum" Value="1" />
            <Setter Property="ShowButtonSpinner" Value="{Binding !$self.IsReadOnly}" />
            <Setter Property="Background" Value="{Binding $self.IsReadOnly, Converter={StaticResource ReadOnlyToTransparentConverter}}" />
            <Setter Property="RenderTransform" Value="Scale(0.9)" />
            <Setter Property="RenderTransformOrigin" Value="100%,50%" />
        </Style>

        <Style Selector="ToggleSwitch.content">
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

    </UserControl.Styles>

    <Grid RowDefinitions="*, auto">

        <!--  Navigationボタン  -->
        <Grid
            Grid.Row="1"
            Background="SeaShell"
            ColumnDefinitions="* *"
            ZIndex="123">

            <Button
                Grid.Column="0"
                Margin="10,10,0,10"
                HorizontalAlignment="Left"
                Command="{Binding NavigatePrevCommand}"
                Content="&lt; 作業エリア設定" />
        </Grid>

        <ScrollViewer Grid.Row="0">
            <Grid RowDefinitions="auto, auto, auto, *, *, *, auto">

                <Label
                    Margin="7,5,3,0"
                    Padding="10,5"
                    HorizontalContentAlignment="Center"
                    Background="YellowGreen"
                    Content="アクティビティ出力"
                    FontSize="20" />

                <!--  アクティビティのパラメータ設定  -->
                <StackPanel Grid.Row="1" Margin="5,5,10,5">

                    <!--  移動アクティビティ  -->
                    <Grid Margin="0,4,0,0" ColumnDefinitions="*, Auto">
                        <StackPanel
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock Classes="title">
                                <Underline>移動</Underline>
                                アクティビティ作成</TextBlock>
                        </StackPanel>
                        <ToggleSwitch
                            Name="makeMove"
                            Grid.Column="1"
                            Classes="content"
                            IsChecked="{Binding EnableMove.Value, FallbackValue=true}" />
                    </Grid>

                    <Border
                        Background="#55e5e5e5"
                        CornerRadius="5"
                        IsVisible="{Binding #makeMove.IsChecked}">
                        <StackPanel Margin="10,3,3,3">

                            <Grid Margin="0,2" ColumnDefinitions="*, Auto">
                                <StackPanel
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                                    <TextBlock Classes="header" Text="初期拡幅" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,2" ColumnDefinitions="*, Auto">
                                <StackPanel
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                                    <TextBlock Classes="header" Text="     前方 (m)" />
                                </StackPanel>
                                <NumericUpDown
                                    Grid.Column="1"
                                    Classes="content"
                                    Value="{Binding InitialMoveMarginFront.Value, FallbackValue=3.0}" />
                            </Grid>

                            <Grid Margin="0,2" ColumnDefinitions="*, Auto">
                                <StackPanel
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                                    <TextBlock Classes="header" Text="     後方 (m)" />
                                </StackPanel>
                                <NumericUpDown
                                    Grid.Column="1"
                                    Classes="content"
                                    Value="{Binding InitialMoveMarginRear.Value, FallbackValue=3.0}" />
                            </Grid>

                            <Grid Margin="0,2" ColumnDefinitions="*, Auto">
                                <StackPanel
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                                    <TextBlock Classes="header" Text="     進捗方向側 (m)" />
                                </StackPanel>
                                <NumericUpDown
                                    Grid.Column="1"
                                    Classes="content"
                                    Value="{Binding InitialMoveMarginNext.Value, FallbackValue=3.0}" />
                            </Grid>

                            <Grid Margin="0,2" ColumnDefinitions="*, Auto">
                                <StackPanel
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                                    <TextBlock Classes="header" Text="     進捗方向手前側 (m)" />
                                </StackPanel>
                                <NumericUpDown
                                    Grid.Column="1"
                                    Classes="content"
                                    Value="{Binding InitialMoveMarginPrev.Value, FallbackValue=3.0}" />
                            </Grid>

                            <Grid Margin="0,2" ColumnDefinitions="*, Auto">
                                <StackPanel
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                                    <TextBlock Classes="header" Text="参照速度 (km/h)" />
                                </StackPanel>
                                <NumericUpDown
                                    Grid.Column="1"
                                    Classes="content"
                                    Value="{Binding RefSpeedMove.Value, FallbackValue=3.0}" />
                            </Grid>

                            <Grid Margin="0,2" ColumnDefinitions="*, Auto">
                                <StackPanel
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                                    <TextBlock Classes="header" Text="端部速度 (km/h)" />
                                </StackPanel>
                                <NumericUpDown
                                    Grid.Column="1"
                                    Classes="content"
                                    IsReadOnly="True"
                                    Value="{Binding EdgeSpeedMove.Value, FallbackValue=3.0}" />
                            </Grid>

                        </StackPanel>
                    </Border>


                    <!--  無起振転圧アクティビティ  -->
                    <Grid Margin="0,4,0,0" ColumnDefinitions="*, Auto">
                        <StackPanel
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock Classes="title">
                                <Underline>無起振</Underline>
                                アクティビティ作成</TextBlock>
                        </StackPanel>
                        <ToggleSwitch
                            Name="makeNonCompaction"
                            Grid.Column="1"
                            Classes="content"
                            IsChecked="{Binding EnableNonCompaction.Value, FallbackValue=true}" />
                    </Grid>


                    <Border
                        Background="#55e5e5e5"
                        CornerRadius="5"
                        IsVisible="{Binding #makeNonCompaction.IsChecked}">
                        <StackPanel Margin="10,3,3,3">


                            <Grid Margin="0,2" ColumnDefinitions="*, Auto">
                                <StackPanel
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                                    <TextBlock Classes="header" Text="繰返し回数" />
                                </StackPanel>
                                <NumericUpDown
                                    Grid.Column="1"
                                    Classes="int"
                                    Value="{Binding RepeatNumNonCompaction.Value, FallbackValue=4}" />
                            </Grid>

                            <Grid Margin="0,2" ColumnDefinitions="*, Auto">
                                <StackPanel
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                                    <TextBlock Classes="header" Text="参照速度 (km/h)" />
                                </StackPanel>
                                <NumericUpDown
                                    Grid.Column="1"
                                    Classes="content"
                                    Minimum="0.1"
                                    Value="{Binding RefSpeedNonCompaction.Value, FallbackValue=3.0}" />
                            </Grid>

                            <Grid Margin="0,2" ColumnDefinitions="*, Auto">
                                <StackPanel
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                                    <TextBlock Classes="header" Text="端部速度 (km/h)" />
                                </StackPanel>
                                <NumericUpDown
                                    Grid.Column="1"
                                    Classes="content"
                                    IsReadOnly="True"
                                    Minimum="0.1"
                                    Value="{Binding EdgeSpeedNonCompaction.Value, FallbackValue=3.0}" />
                            </Grid>

                        </StackPanel>
                    </Border>

                    <!--  起振転圧アクティビティ  -->
                    <Grid Margin="0,4,0,0" ColumnDefinitions="*, Auto">
                        <StackPanel
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock Classes="title">
                                <Underline>起振</Underline>
                                アクティビティ作成</TextBlock>
                        </StackPanel>
                        <ToggleSwitch
                            Name="makeCompaction"
                            Grid.Column="1"
                            Classes="content"
                            IsChecked="{Binding EnableCompaction.Value, FallbackValue=true}" />
                    </Grid>

                    <Border
                        Background="#55e5e5e5"
                        CornerRadius="5"
                        IsVisible="{Binding #makeCompaction.IsChecked}">
                        <StackPanel Margin="10,3,3,3">


                            <Grid Margin="0,2" ColumnDefinitions="*, Auto">
                                <StackPanel
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                                    <TextBlock Classes="header" Text="繰返し回数" />
                                </StackPanel>
                                <NumericUpDown
                                    Grid.Column="1"
                                    Classes="int"
                                    Value="{Binding RepeatNumCompaction.Value, FallbackValue=4}" />
                            </Grid>

                            <Grid Margin="0,2" ColumnDefinitions="*, Auto">
                                <StackPanel
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                                    <TextBlock Classes="header" Text="参照速度 (km/h)" />
                                </StackPanel>
                                <NumericUpDown
                                    Grid.Column="1"
                                    Classes="content"
                                    Value="{Binding RefSpeedCompaction.Value, FallbackValue=3.0}" />
                            </Grid>

                            <Grid Margin="0,2" ColumnDefinitions="*, Auto">
                                <StackPanel
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                                    <TextBlock Classes="header" Text="端部速度 (km/h)" />
                                </StackPanel>
                                <NumericUpDown
                                    Grid.Column="1"
                                    Classes="content"
                                    IsReadOnly="True"
                                    Value="{Binding EdgeSpeedCompaction.Value, FallbackValue=3.0}" />
                            </Grid>

                        </StackPanel>

                    </Border>

                </StackPanel>

                <!--  CreateActivityボタン  -->
                <Button
                    Grid.Row="2"
                    Margin="20,10"
                    HorizontalAlignment="Stretch"
                    Command="{Binding CreateActivityCommand}">
                    <TextBlock
                        Margin="5"
                        Classes="header"
                        FontSize="18"
                        Text="アクティビティを作成" />
                </Button>

                <Border
                    Grid.Row="3"
                    Margin="10,20,10,10"
                    Background="MintCream"
                    BorderBrush="LightBlue"
                    BorderThickness="1"
                    CornerRadius="5"
                    IsEnabled="{Binding ActivityCreated.Value}">
                    <Grid
                        Margin="10"
                        ColumnDefinitions="auto  *"
                        RowDefinitions="auto auto auto">
                        <TextBlock
                            Grid.ColumnSpan="3"
                            Margin="0,-23,0,0"
                            Classes="header"
                            FontSize="18"
                            Text="アクティビティ確認" />

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="作業グループ" />
                        <ComboBox
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="5"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            ItemsSource="{Binding GroupIds}"
                            SelectedIndex="{Binding SelectedGroupIndex.Value, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:GroupItem">
                                    <TextBlock Text="{Binding Tag}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="アクティビティ番号" />
                        <NumericUpDown
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="5"
                            VerticalAlignment="Center"
                            FormatString="0"
                            IsEnabled="{Binding SelectedGroupIndex.Value, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Value="{Binding SelectedActivityIndex.Value}" />
                    </Grid>
                </Border>

                <Border
                    Grid.Row="4"
                    Margin="10,20,10,10"
                    Background="MintCream"
                    BorderBrush="LightBlue"
                    BorderThickness="1"
                    CornerRadius="5"
                    IsEnabled="{Binding ActivityCreated.Value}">
                    <Grid
                        Margin="10"
                        ColumnDefinitions="auto  *"
                        RowDefinitions="auto auto auto auto auto auto auto">
                        <TextBlock
                            Grid.ColumnSpan="2"
                            Margin="0,-23,0,0"
                            Classes="header"
                            FontSize="18"
                            Text="アクティビティ出力先の設定" />

                        <TextBox
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Margin="5"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            IsReadOnly="True"
                            Text="{Binding OutputFolderPath.Value}"
                            TextWrapping="WrapWithOverflow"
                            Watermark="出力先フォルダを右のボタンから選択">
                            <TextBox.InnerRightContent>
                                <Button Command="{Binding SetFolderCommand}" Content="...">
                                    <Button.Styles>
                                        <FluentTheme />
                                    </Button.Styles>
                                </Button>
                            </TextBox.InnerRightContent>
                        </TextBox>


                        <TextBlock
                            Grid.Row="2"
                            Grid.ColumnSpan="2"
                            VerticalAlignment="Center"
                            Text="日付を挿入する" />
                        <ToggleSwitch
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="5,0,5,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            IsChecked="{Binding InsertDate.Value}" />
                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="エリア名" />
                        <TextBox
                            Grid.Row="3"
                            Grid.Column="1"
                            Margin="5"
                            VerticalAlignment="Center"
                            Text="{Binding AreaName.Value}"
                            Watermark="任意" />
                        <TextBlock
                            Grid.Row="4"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="リフト名" />
                        <TextBox
                            Grid.Row="4"
                            Grid.Column="1"
                            Margin="5"
                            VerticalAlignment="Center"
                            Text="{Binding LiftName.Value}"
                            Watermark="任意" />

                        <TextBlock
                            Grid.Row="5"
                            Grid.ColumnSpan="2"
                            Margin="5"
                            VerticalAlignment="Center"
                            Text="{Binding OutputFolderPrefix.Value, StringFormat='(出力フォルダ名: {0})'}"
                            TextWrapping="WrapWithOverflow" />


                        <Button
                            Grid.Row="6"
                            Grid.ColumnSpan="2"
                            Margin="15,5"
                            HorizontalAlignment="Stretch"
                            Command="{Binding OutputCommand}">
                            <Button.Content>
                                <TextBlock>
                                    <Run
                                        FontSize="16"
                                        FontWeight="Bold"
                                        Text="出力する" />
                                </TextBlock>
                            </Button.Content>
                        </Button>
                    </Grid>
                </Border>

            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
