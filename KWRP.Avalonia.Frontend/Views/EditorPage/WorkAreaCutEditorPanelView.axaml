<UserControl
    x:Class="KWRP.Avalonia.Frontend.Views.EditorPage.WorkAreaCutEditorPanelView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:i18n="clr-namespace:KWRP.Frontend.Models.Localizer"
    xmlns:model="using:KWRP.Avalonia.Frontend.Models"
    xmlns:vm="using:KWRP.Avalonia.Frontend.ViewModels.EditorPage"
    x:DataType="vm:WorkAreaCutEditorPanelViewModel"
    mc:Ignorable="d">

    <Grid Margin="10,20" RowDefinitions="* auto">

        <ScrollViewer Grid.Row="0">

            <StackPanel Spacing="10">


                <Grid ColumnDefinitions="auto *">

                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{i18n:Localize WorkAreaCutEditor.DivCount}" />
                    <NumericUpDown
                        Name="cuts"
                        Grid.Column="1"
                        FormatString="0"
                        Increment="1"
                        Minimum="0"
                        Value="{Binding CutCount.Value}" />

                </Grid>

                
                <DataGrid
                    Margin="20"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    CanUserSortColumns="False"
                    GridLinesVisibility="All"
                    IsVisible="{Binding !!CutCount.Value}"
                    ItemsSource="{Binding CutProperties}">

                    <DataGrid.Columns>
                        <DataGridTextColumn
                            x:DataType="model:CutProperty"
                            Binding="{Binding Ratio, UpdateSourceTrigger=LostFocus}"
                            Header="{i18n:Localize WorkAreaCutEditor.LengthRatio}"
                            IsReadOnly="False"
                            MinWidth="80"
                            MaxWidth="150" />

                        <DataGridTextColumn
                            x:DataType="model:CutProperty"
                            Binding="{Binding Percentage, StringFormat='{}{0:0.00}%'}"
                            Header="{i18n:Localize WorkAreaCutEditor.Percentage}"
                            IsReadOnly="True"
                            MinWidth="80"
                            MaxWidth="120" />
                    </DataGrid.Columns>

                </DataGrid>

                <Button
                    Margin="20"
                    HorizontalAlignment="Stretch"
                    Command="{Binding CutCommand}"
                    Content="{i18n:Localize WorkAreaCutEditor.Confirm}"
                    IsVisible="{Binding !!CutCount.Value}" />

            </StackPanel>

        </ScrollViewer>

    </Grid>

</UserControl>
