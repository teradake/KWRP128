<UserControl
    x:Class="KWRP.Avalonia.Frontend.Views.EditorPage.LaneCreationPanelView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:KWRP.Avalonia.Frontend.ViewModels.EditorPage"
    Name="laneArrangementEditor"
    d:DesignHeight="650"
    d:DesignWidth="300"
    x:CompileBindings="True"
    x:DataType="vm:LaneCreationPanelViewModel"
    Focusable="True"
    mc:Ignorable="d">
    <UserControl.IsEnabled>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="!IsDirectionSelectionMode.Value" />
            <Binding Path="!IsOptimizing.Value" />
        </MultiBinding>
    </UserControl.IsEnabled>

    <Grid>

        <TransitioningContentControl
            Width="{Binding $parent[UserControl].Bounds.Width}"
            Content="{Binding SettingPage, FallbackValue=setting page}"
            IsVisible="{Binding #setting.IsChecked}" />

        <ToggleButton
            Name="setting"
            Margin="4"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Background="Transparent"
            BorderBrush="Transparent"
            Content="setting"
            ZIndex="22">
            <ToggleButton.Styles>
                <Style Selector="ToggleButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="#44ffffff" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                </Style>
                <Style Selector="ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                </Style>
                <Style Selector="ToggleButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="RenderTransform" Value="Scale(0.95)" />
                </Style>
                <Style Selector="Image">
                    <Setter Property="Height" Value="30" />
                </Style>
            </ToggleButton.Styles>
            <Panel>
                <Image IsVisible="{Binding #setting.IsChecked}" Source="/Assets/Icons/close_red.png" />
                <Image IsVisible="{Binding !#setting.IsChecked}" Source="/Assets/Icons/setting_fill_gray.png" />
            </Panel>
        </ToggleButton>

        <Grid IsVisible="{Binding !#setting.IsChecked}" RowDefinitions="*, auto">





            <!--<CheckBox IsChecked="{Binding LaneCreated.Value}" HorizontalAlignment="Left" VerticalAlignment="Top" ZIndex="10"/>-->

            <!--  Navigationボタン  -->
            <Grid
                Grid.Row="1"
                Background="SeaShell"
                ColumnDefinitions="* *">

                <Button
                    Grid.Column="1"
                    Margin="0,10,10,10"
                    HorizontalAlignment="Right"
                    Command="{Binding NavigateNextCommand}"
                    Content="作業エリア設定 >" />

            </Grid>

            <ScrollViewer Grid.Row="0">

                <Grid Grid.Row="0" RowDefinitions="auto, *, auto, *">

                    <!--  区割りパラメータUI  -->
                    <Label
                        Grid.Row="0"
                        Margin="0,5,0,10"
                        Padding="5"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Background="AntiqueWhite"
                        Content="区割りパラメータ"
                        FontSize="20" />

                    <Grid
                        Grid.Row="1"
                        Margin="0"
                        RowDefinitions="auto, auto, auto, auto, auto auto auto auto auto auto auto">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" MinWidth="150" />
                        </Grid.ColumnDefinitions>
                        <Grid.Styles>
                            <Style Selector="TextBlock">
                                <!--<Setter Property="FontFamily" Value="MS Gothic"/>-->
                                <Setter Property="HorizontalAlignment" Value="Left" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                            <Style Selector="NumericUpDown">
                                <Setter Property="ShowButtonSpinner" Value="{Binding !$self.IsReadOnly}" />
                                <Setter Property="Background" Value="{Binding $self.IsReadOnly, Converter={StaticResource ReadOnlyToTransparentConverter}}" />
                                <Setter Property="FormatString" Value="0.00" />
                                <Setter Property="Increment" Value="0.05" />
                                <Setter Property="Classes.SafeMode" Value="{Binding !IsDevMode}" />
                            </Style>
                            <Style Selector="NumericUpDown.adaptiveon">
                                <Setter Property="Increment" Value="10.0" />
                            </Style>
                            <Style Selector="NumericUpDown.SafeMode">
                                <Setter Property="Minimum" Value="0" />
                            </Style>
                        </Grid.Styles>


                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="鉄輪幅 (m)" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Text="前方オフセット (m)" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Text="後方オフセット (m)" />
                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            Text="側方オフセット① (m)" />
                        <TextBlock
                            Grid.Row="4"
                            Grid.Column="0"
                            Text="側方オフセット② (m)" />
                        <TextBlock
                            Grid.Row="5"
                            Grid.Column="0"
                            Text="レーンラップ幅 (m)" />
                        <TextBlock
                            Grid.Row="6"
                            Grid.Column="0"
                            Text="作業可能長さ (m)" />
                        <TextBlock
                            Grid.Row="7"
                            Grid.Column="0"
                            Text="作業進捗方向 (deg.)" />
                        <TextBlock
                            Grid.Row="8"
                            Grid.Column="0"
                            Text="振動ローラ向き (deg.)" />
                        <TextBlock
                            Grid.Row="9"
                            Grid.Column="0"
                            Text="" />

                        <NumericUpDown
                            Grid.Row="0"
                            Grid.Column="2"
                            IsReadOnly="True"
                            Value="{Binding LaneWidth.Value}" />
                        <NumericUpDown
                            Grid.Row="1"
                            Grid.Column="2"
                            IsReadOnly="False"
                            Value="{Binding FrontOffset.Value}" />
                        <NumericUpDown
                            Grid.Row="2"
                            Grid.Column="2"
                            IsReadOnly="False"
                            Value="{Binding RearOffset.Value}" />
                        <NumericUpDown
                            Grid.Row="3"
                            Grid.Column="2"
                            IsReadOnly="False"
                            Value="{Binding SidePrevOffset.Value}" />
                        <NumericUpDown
                            Grid.Row="4"
                            Grid.Column="2"
                            IsReadOnly="False"
                            Value="{Binding SideNextOffset.Value}" />
                        <NumericUpDown
                            Grid.Row="5"
                            Grid.Column="2"
                            Increment="0.01"
                            IsReadOnly="False"
                            Minimum="0.0001"
                            Value="{Binding LapWidth.Value}" />
                        <NumericUpDown
                            Grid.Row="6"
                            Grid.Column="2"
                            IsReadOnly="True"
                            Minimum="0.01"
                            Value="{Binding LaneChangeLength.Value}" />
                        <NumericUpDown
                            Grid.Row="7"
                            Grid.Column="2"
                            Classes.adaptiveon="{Binding #toggleDirection.IsChecked}"
                            IsReadOnly="False"
                            Value="{Binding ProgressDirectionDegree.Value}" />
                        <NumericUpDown
                            Grid.Row="8"
                            Grid.Column="2"
                            IsReadOnly="True"
                            Value="{Binding RollerHeadingDirectionDegree.Value}" />


                        <Button
                            Grid.Row="9"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Margin="10"
                            HorizontalAlignment="Stretch"
                            Command="{Binding ChangeHeadingCommand}"
                            Content="ローラ向き反転" />

                        <!--<StackPanel
                            Grid.Row="10"
                            Grid.ColumnSpan="3"
                            Margin="0,5"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="10">
                            <Button Command="{Binding AddCommand}" Content="add" />
                            <Button Command="{Binding AddRangeCommand}" Content="addrng" />
                            <Button Command="{Binding ClearCommand}" Content="clear" />
                            <Button Command="{Binding LaneArrangementCommand}" Content="レーン割" />
                        </StackPanel>-->
                        <TextBlock
                            Grid.Row="10"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="作業進捗方向変化量" />
                        <ToggleSwitch
                            Name="toggleDirection"
                            Grid.Row="10"
                            Grid.Column="1"
                            Grid.ColumnSpan="3"
                            HorizontalAlignment="Center"
                            OffContent="±0.05 deg."
                            OnContent="±10 deg." />
                    </Grid>

                    <!--  ペアリングパラメータUI  -->
                    <Label
                        Grid.Row="2"
                        Margin="0,10"
                        Padding="5"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Background="Aquamarine"
                        Content="レーンのペアリング"
                        FontSize="20" />

                    <Grid
                        Grid.Row="3"
                        Margin="0"
                        RowDefinitions="auto, auto, auto, auto, auto auto auto auto auto auto">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" MinWidth="130" />
                        </Grid.ColumnDefinitions>
                        <Grid.Styles>
                            <Style Selector="TextBlock">
                                <!--<Setter Property="FontFamily" Value="MS Gothic"/>-->
                                <Setter Property="HorizontalAlignment" Value="Left" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                            <Style Selector="NumericUpDown">
                                <Setter Property="ShowButtonSpinner" Value="{Binding !$self.IsReadOnly}" />
                            </Style>
                        </Grid.Styles>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="最小レーン数" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Text="最大レーン数" />

                        <NumericUpDown
                            Name="pairMinCnt"
                            Grid.Row="0"
                            Grid.Column="2"
                            FormatString="0"
                            IsReadOnly="False"
                            Maximum="{Binding #pairMaxCnt.Value}"
                            Minimum="1"
                            Value="{Binding PairMinCount.Value}" />
                        <NumericUpDown
                            Name="pairMaxCnt"
                            Grid.Row="1"
                            Grid.Column="2"
                            FormatString="0"
                            IsReadOnly="False"
                            Minimum="{Binding #pairMinCnt.Value}"
                            Value="{Binding PairMaxCount.Value}" />

                    </Grid>

                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>