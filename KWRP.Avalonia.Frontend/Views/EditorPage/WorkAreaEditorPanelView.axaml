<UserControl
    x:Class="KWRP.Avalonia.Frontend.Views.EditorPage.WorkAreaEditorPanelView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enum="using:KWRP.Avalonia.Backend.Enums"
    xmlns:i18n="clr-namespace:KWRP.Frontend.Models.Localizer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:KWRP.Avalonia.Frontend.ViewModels.EditorPage"
    d:DesignHeight="650"
    d:DesignWidth="400"
    x:CompileBindings="True"
    x:DataType="vm:WorkAreaEditorPanelViewModel"
    Focusable="True"
    mc:Ignorable="d">

    <Grid RowDefinitions="*, auto">

        <!--  Navigationボタン  -->
        <Grid
            Grid.Row="1"
            Background="SeaShell"
            ColumnDefinitions="* *"
            ZIndex="123">

            <Button
                Grid.Column="0"
                Margin="10,10,0,10"
                HorizontalAlignment="Left"
                Command="{Binding NavigatePrevCommand}">
                <Button.Content>
                    <TextBlock>
                    &lt;<Run Text="{i18n:Localize WorkAreaEditor.LaneSetting}"/>
                    </TextBlock>
                </Button.Content>
            </Button>

            <Button
                Grid.Column="1"
                Margin="0,10,10,10"
                HorizontalAlignment="Right"
                Command="{Binding NavigateNextCommand}">
                <Button.Content>
                    <TextBlock>
                    <Run Text="{i18n:Localize WorkAreaEditor.ActivitySetting}"/>&gt;
                    </TextBlock>
                </Button.Content>
            </Button>

        </Grid>

        <ScrollViewer Grid.Row="0" IsVisible="{Binding #cutMode.IsChecked}">
            <Grid RowDefinitions="30 *">
                <ToggleButton
                    Grid.Row="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    IsChecked="{Binding !#cutMode.IsChecked}">
                    <ToggleButton.Styles>
                        <Style Selector="ToggleButton:unchecked /template/ ContentPresenter#PART_ContentPresenter">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                        </Style>
                        <Style Selector="ToggleButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                            <Setter Property="Background" Value="#44ffffff" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                        </Style>
                        <Style Selector="ToggleButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
                            <Setter Property="RenderTransform" Value="Scale(0.95)" />
                        </Style>
                        <Style Selector="Image">
                            <Setter Property="Height" Value="45" />
                        </Style>
                    </ToggleButton.Styles>
                    <Image Source="/Assets/Icons/close_red.png" />
                </ToggleButton>
                <ContentControl Grid.Row="1" Content="{Binding CutEditor, FallbackValue=cutEditor}" />
            </Grid>
        </ScrollViewer>

        <ScrollViewer Grid.Row="0" IsVisible="{Binding !#cutMode.IsChecked}">

            <Grid RowDefinitions="auto,*">

                <Label
                    Margin="7,5,3,0"
                    Padding="10,5"
                    HorizontalContentAlignment="Center"
                    Background="RosyBrown"
                    Content="{i18n:Localize WorkAreaEditor.Setting}"
                    FontSize="20" />

                <StackPanel Grid.Row="1" Spacing="10">

                    <Button
                        Margin="20,20,20,0"
                        HorizontalAlignment="Stretch"
                        Command="{Binding ClearCommand}"
                        Content="{i18n:Localize WorkAreaEditor.ClearSelection}" />

                  <Button
                        Margin="20,20,20,0"
                        HorizontalAlignment="Stretch"
                        Command="{Binding UndoCommand}"
                        Content="{i18n:Localize WorkAreaEditor.Undo}" />

                    <Border
                        Margin="10,20,10,10"
                        Background="AliceBlue"
                        BorderBrush="LightBlue"
                        BorderThickness="1"
                        CornerRadius="5">
                        <Grid
                            Margin="10"
                            ColumnDefinitions="auto  *"
                            RowDefinitions="auto auto auto">
                            <TextBlock
                                Grid.ColumnSpan="3"
                                Margin="0,-23,0,0"
                                Classes="header"
                                FontSize="16"
                                FontWeight="Bold"
                                Text="{i18n:Localize WorkAreaEditor.AreaDivision}" />

                            <ToggleButton
                                Name="cutMode"
                                Grid.ColumnSpan="2"
                                Margin="10,7,10,5"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Content="{i18n:Localize WorkAreaEditor.Divide}" />
                        </Grid>
                    </Border>

                    <Border
                        Margin="10"
                        Background="AliceBlue"
                        BorderBrush="LightBlue"
                        BorderThickness="1"
                        CornerRadius="5">
                        <Grid
                            Margin="10"
                            ColumnDefinitions="*  *"
                            RowDefinitions="auto auto auto">
                            <TextBlock
                                Grid.ColumnSpan="3"
                                Margin="0,-23,0,0"
                                Classes="header"
                                FontSize="16"
                                FontWeight="Bold"
                                Text="{i18n:Localize WorkAreaEditor.RollerDirection}" />

                            <Button
                                Grid.Column="0"
                                Margin="10,7,10,5"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Command="{Binding RollerDirectionSwapCommand}"
                                CommandParameter="{x:False}"
                                Content="{i18n:Localize WorkAreaEditor.NoReverse}" />
                            <Button
                                Grid.Column="1"
                                Margin="10,7,10,5"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Command="{Binding RollerDirectionSwapCommand}"
                                CommandParameter="{x:True}"
                                Content="{i18n:Localize WorkAreaEditor.Reverse}" />
                        </Grid>
                    </Border>

                    <Border
                        Margin="10"
                        Background="AliceBlue"
                        BorderBrush="LightBlue"
                        BorderThickness="1"
                        CornerRadius="5">
                        <Grid
                            Margin="10"
                            ColumnDefinitions="*  *"
                            RowDefinitions="auto auto auto">
                            <TextBlock
                                Grid.ColumnSpan="3"
                                Margin="0,-23,0,0"
                                Classes="header"
                                FontSize="16"
                                FontWeight="Bold"
                                Text="{i18n:Localize WorkAreaEditor.MoveActivityGoal}" />

                            <Button
                                Grid.Column="0"
                                Margin="10,7,10,5"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Command="{Binding GoalAreaCommand}"
                                CommandParameter="{x:Static enum:GoalAreaLocation.Prev}"
                                Content="{i18n:Localize WorkAreaEditor.GoalFront}" />
                            <Button
                                Grid.Column="1"
                                Margin="10,7,10,5"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Command="{Binding GoalAreaCommand}"
                                CommandParameter="{x:Static enum:GoalAreaLocation.Next}"
                                Content="{i18n:Localize WorkAreaEditor.GoalBack}" />
                        </Grid>
                    </Border>

                    <Border
                        Margin="10"
                        Background="AliceBlue"
                        BorderBrush="LightBlue"
                        BorderThickness="1"
                        CornerRadius="5">
                        <Grid
                            Margin="10"
                            ColumnDefinitions="* *"
                            RowDefinitions="auto auto auto auto">
                            <TextBlock
                                Grid.ColumnSpan="3"
                                Margin="0,-23,0,0"
                                Classes="header"
                                FontSize="16"
                                FontWeight="Bold"
                                Text="{i18n:Localize WorkAreaEditor.AreaShaping}" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,5,0,0"
                                Text="{i18n:Localize WorkAreaEditor.ShapingFront}" />
                            <Button
                                Grid.Row="1"
                                Grid.Column="0"
                                Margin="10,0,5,5"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Command="{Binding LaneTrimFrontCommand}"
                                CommandParameter="{x:Static enum:WorkAreaLaneTrimType.None}"
                                Content="{i18n:Localize WorkAreaEditor.NoTrim}" />
                            <Button
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="5,0,10,5"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Command="{Binding LaneTrimFrontCommand}"
                                CommandParameter="{x:Static enum:WorkAreaLaneTrimType.Cut}"
                                Content="{i18n:Localize WorkAreaEditor.Trim}" />

                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="0"
                                Text="{i18n:Localize WorkAreaEditor.ShapingRear}" />
                            <Button
                                Grid.Row="3"
                                Grid.Column="0"
                                Margin="10,0,5,5"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Command="{Binding LaneTrimRearCommand}"
                                CommandParameter="{x:Static enum:WorkAreaLaneTrimType.None}"
                                Content="{i18n:Localize WorkAreaEditor.NoTrim}" />
                            <Button
                                Grid.Row="3"
                                Grid.Column="1"
                                Margin="5,0,10,5"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Command="{Binding LaneTrimRearCommand}"
                                CommandParameter="{x:Static enum:WorkAreaLaneTrimType.Cut}"
                                Content="{i18n:Localize WorkAreaEditor.Trim}" />
                        </Grid>
                    </Border>

                    <Button
                        Margin="20,0"
                        HorizontalAlignment="Stretch"
                        Command="{Binding RefleshCommand}"
                        Content="{i18n:Localize WorkAreaEditor.Reset}" />


                </StackPanel>

            </Grid>

        </ScrollViewer>

    </Grid>

</UserControl>
